{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spanish Psychology LLM Benchmark Question",
  "description": "Schema for questions used to evaluate Spanish-language large language models in psychology.",
  "type": "object",
  "required": [
    "id",
    "dimension",
    "topic",
    "difficulty",
    "question",
    "expected_answer",
    "evaluation_criteria",
    "language"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{3}-[0-9]{3}$"
    },
    "dimension": {
      "type": "string",
      "enum": [
        "knowledge",
        "reasoning",
        "critical_analysis",
        "uncertainty",
        "communication"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 2
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 10
    },
    "expected_answer": {
      "type": "string",
      "minLength": 10
    },
    "evaluation_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "max_points"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 5
          },
          "max_points": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "es-ES"
      ]
    }
  },
  "additionalProperties": false
}